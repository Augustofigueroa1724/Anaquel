# Anaquel · firma y subida a TestFlight desde GitHub Actions (no hay Mac).
# Copiado del Fastfile de Fifth Square, que ya llega a TestFlight. Diferencia:
# Anaquel va con Capacitor 6 y CocoaPods (lo exige el plugin de ML Kit), así que
# se compila el .xcworkspace, no el .xcodeproj.
#
# `match` crea UNA vez el certificado de distribución y el perfil App Store con la
# clave de la API de App Store Connect, los cifra con MATCH_PASSWORD y los guarda
# en la rama `certs` de este repo; cada run los descifra en un llavero temporal.
default_platform(:ios)

APP_ID = "app.anaquel.catalogo"

def token_asc
  Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: ENV.fetch("AUTH_KEY")
  )
end

platform :ios do
  desc "Registra el App ID si no existe y comprueba que la app está creada en App Store Connect"
  lane :registra do
    Spaceship::ConnectAPI.token = token_asc
    if Spaceship::ConnectAPI::BundleId.find(APP_ID).nil?
      Spaceship::ConnectAPI::BundleId.create(name: "Anaquel", platform: "IOS", identifier: APP_ID)
      UI.success("App ID #{APP_ID} registrado")
    else
      UI.message("El App ID #{APP_ID} ya existía")
    end
    if Spaceship::ConnectAPI::App.find(APP_ID).nil?
      UI.user_error!("Falta crear la app en App Store Connect (Apps → + → Nueva app) con el bundle ID #{APP_ID}. La API de Apple no permite crearla.")
    end
    UI.success("La app existe en App Store Connect")

    # Los certificados de distribución tienen tope por cuenta. Fifth Square y Crate
    # Mates guardan los suyos con match; si alguno ya no existe, su próxima build
    # necesita «perfil_nuevo». Solo se muestran los IDs, que no son secretos.
    ids = Spaceship::ConnectAPI::Certificate.all.select { |c| c.certificate_type.to_s.include?("DISTRIBUTION") }.map(&:id)
    UI.message("Certificados de distribución en la cuenta: #{ids.join(', ')}")
    { "78G9JJ88JS" => "Fifth Square", "4Z5BYZ528H" => "Crate Mates" }.each do |id, app|
      ids.include?(id) ? UI.success("#{app}: su certificado #{id} sigue activo") : UI.important("#{app}: su certificado #{id} ya no existe")
    end
  end

  desc "Archiva firmado y sube a TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("AUTH_KEY"),
      in_house: false
    )
    setup_ci

    # Sign in with Apple tiene que estar activado en el App ID o el perfil no lo
    # incluye y la firma falla. Se activa aquí con la clave de la API (como en Fifth
    # Square) y, si se acaba de activar, se regenera el perfil.
    capacidad_nueva = false
    begin
      Spaceship::ConnectAPI.token = token_asc
      bundle = Spaceship::ConnectAPI::BundleId.find(APP_ID)
      tipo = Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH
      if bundle && bundle.get_capabilities.none? { |c| c.is_type?(tipo) }
        ajustes = [{
          key: Spaceship::ConnectAPI::BundleIdCapability::Settings::APPLE_ID_AUTH_APP_CONSENT,
          options: [{ key: Spaceship::ConnectAPI::BundleIdCapability::Options::PRIMARY_APP_CONSENT }]
        }]
        bundle.create_capability(tipo, settings: ajustes)
        capacidad_nueva = true
        UI.success("Sign in with Apple activado en el App ID #{APP_ID}")
      end
    rescue => e
      UI.important("No se pudo comprobar Sign in with Apple en el App ID: #{e.message}")
    end

    match(
      force: capacidad_nueva || ENV["MATCH_FORCE"] == "true",
      type: "appstore",
      app_identifier: APP_ID,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      api_key: api_key,
      readonly: false,
      storage_mode: "git",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "certs",
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION")
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      targets: ["App"],
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")
    )
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "MARKETING_VERSION=#{ENV.fetch('APP_VERSION')} CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}",
      output_directory: ENV.fetch("RUNNER_TEMP"),
      output_name: "anaquel.ipa"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
